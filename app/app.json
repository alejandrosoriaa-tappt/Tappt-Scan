{
  "expo": {
    "name": "TapptScan",
    "slug": "tappt-scan",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#18B875",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#18B875"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "lat.tappt.scan",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "lat.tappt.scan",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "TapptScan usa la cámara para escanear tus documentos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TapptScan accede a tus fotos para que puedas importar documentos que ya tienes."
        }
      ],
      "expo-document-picker",
      "expo-localization"
    ],
    "web": {
      "bundler": "metro",
      "name": "TapptScan",
      "shortName": "TapptScan",
      "themeColor": "#18B875",
      "backgroundColor": "#F8FAFC",
      "display": "standalone",
      "favicon": "./assets/favicon.png"
    }
  }
}
