{
  "expo": {
    "name": "TapptScan",
    "slug": "tappt-scan",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F766E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "lat.tappt.scan",
      "infoPlist": {
        "NSCameraUsageDescription": "TapptScan usa la cámara para escanear tus documentos."
      }
    },
    "android": {
      "package": "lat.tappt.scan",
      "permissions": ["CAMERA"]
    }
  }
}
