# =============================================================================
#  TapptScan — variables del backend
#  Guía paso a paso: docs/PUESTA-EN-MARCHA.md
# =============================================================================

# --- WhatsApp Cloud API (número PROPIO de TapptScan) -------------------------
# Meta → developers.facebook.com → tu app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Lo inventas tú; el mismo string se escribe en Meta al dar de alta el webhook.
WHATSAPP_VERIFY_TOKEN=
# Meta → Configuración de la app → Básica → Clave secreta de la app.
# Con esto se verifica la firma de cada webhook. Si se deja vacío, NO se
# verifica y cualquiera que descubra la URL puede simular mensajes.
WHATSAPP_APP_SECRET=

# Número de TapptScan en formato internacional. Se usa para armar el enlace
# wa.me del acceso: la app abre WhatsApp con el código ya escrito.
WHATSAPP_NUMERO=+5215644170712

# Guardrail de identidad: el server aborta si WHATSAPP_PHONE_NUMBER_ID no
# coincide. Evita procesar mensajes con las credenciales de otra vertical
# (tappt-backend, tappt-broker). Repite aquí el mismo valor de arriba.
EXPECTED_WHATSAPP_PHONE_NUMBER_ID=

# --- Sesiones -----------------------------------------------------------------
# Firma los tokens de sesión de la app. Cualquier cadena larga y aleatoria;
# generar con:  openssl rand -base64 48
# Cambiarla cierra la sesión de todos los usuarios.
JWT_SECRET=

# --- Supabase (solo base de datos; la autenticación es por WhatsApp) ----------
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Clasifica y extrae datos de la imagen del documento.
CLAUDE_VISION_MODEL=claude-opus-4-8
# Traduce las preguntas de gasto a filtros y redacta la respuesta.
CLAUDE_CONSULTAS_MODEL=claude-opus-4-8

# --- Google Drive OAuth ------------------------------------------------------
# Google Cloud Console → Credenciales → OAuth client ID → Web application.
# Ver docs/GOOGLE-DRIVE.md: usamos SOLO el scope drive.file a propósito.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTO con el "Authorized redirect URI" de la consola:
#   https://<tu-dominio-railway>/api/drive/callback
GOOGLE_REDIRECT_URI=

# --- Stripe (cobro de planes Personal/Negocio) -------------------------------
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → tu endpoint → Signing secret.
# Sin esto el webhook rechaza todo: la firma no se puede verificar.
STRIPE_WEBHOOK_SECRET=
# Moneda por defecto si el usuario no tiene una guardada: mxn, usd o eur.
STRIPE_MONEDA=mxn
STRIPE_SUCCESS_URL=https://tappt.lat/scan/gracias
STRIPE_CANCEL_URL=https://tappt.lat/scan

# --- Servidor ----------------------------------------------------------------
# Railway lo inyecta solo; no hace falta definirlo.
PORT=3000
