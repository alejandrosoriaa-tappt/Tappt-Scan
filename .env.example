# --- WhatsApp Cloud API (número propio de TapptScan, NO el de Tappt) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Guardrail de identidad: el server no arranca si WHATSAPP_PHONE_NUMBER_ID
# no coincide con este valor esperado (protege contra cruzar números con
# tappt-backend o tappt-broker por error de configuración).
EXPECTED_WHATSAPP_PHONE_NUMBER_ID=

# --- Supabase (proyecto/schema propio de TapptScan, NO el de Tappt) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (clasificación + extracción por visión) ---
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-opus-4-8

# --- Google Drive OAuth (cuenta del propio usuario final, no de servicio) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Stripe (cobro de planes Personal/Negocio, internacional) ---
STRIPE_SECRET_KEY=
# Secreto del endpoint del webhook (Stripe Dashboard → Developers → Webhooks).
# Sin esto no se puede verificar la firma y el webhook rechaza todo.
STRIPE_WEBHOOK_SECRET=
# Moneda por defecto cuando el usuario no tiene una guardada (mxn, usd, eur).
STRIPE_MONEDA=mxn
STRIPE_SUCCESS_URL=https://tappt.lat/scan/gracias
STRIPE_CANCEL_URL=https://tappt.lat/scan

# --- Servidor ---
PORT=3000
